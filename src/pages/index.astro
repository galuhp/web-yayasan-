---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '[Nama Panti Asuhan] — [Tagline Singkat]',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Section -->
  <Hero
    tagline="[Tagline Yayasan / Panti Asuhan]"
    actions={[
      {
        variant: 'primary',
        text: 'Donasi Sekarang',
        href: getPermalink('/donasi'),
        icon: 'tabler:heart-handshake',
      },
      {
        text: 'Tentang Kami',
        href: getPermalink('/tentang'),
      },
    ]}
    image={{ src: '~/assets/images/placeholders/hero-panti.png', alt: '[Placeholder: Foto Utama Panti Asuhan]' }}
  >
    <Fragment slot="title">
      [Judul Utama Halaman Beranda] <span class="text-accent dark:text-white">[Sorotan Judul]</span>
    </Fragment>

    <Fragment slot="subtitle">
      [Sub-judul singkat: deskripsi 1-2 kalimat mengenai peran dan tujuan panti asuhan]
    </Fragment>
  </Hero>

  <!-- Statistik Singkat -->
  <Stats
    title="[Judul Bagian Statistik]"
    subtitle="[Sub-judul singkat statistik]"
    stats={[
      { title: 'Anak Asuh', amount: '[Jumlah]' },
      { title: 'Tahun Berdiri', amount: '[Tahun]' },
      { title: 'Program Pembinaan', amount: '[Jumlah]' },
      { title: 'Relawan & Pengasuh', amount: '[Jumlah]' },
    ]}
  />

  <!-- Sekilas Tentang Panti -->
  <Content
    isReversed
    tagline="Sekilas Tentang Kami"
    title="[Judul Pengenalan Singkat Panti Asuhan]"
    items={[
      {
        title: '[Poin Keunggulan / Nilai 1]',
        description: '[Placeholder deskripsi singkat poin 1]',
      },
      {
        title: '[Poin Keunggulan / Nilai 2]',
        description: '[Placeholder deskripsi singkat poin 2]',
      },
      {
        title: '[Poin Keunggulan / Nilai 3]',
        description: '[Placeholder deskripsi singkat poin 3]',
      },
    ]}
    image={{
      src: '~/assets/images/placeholders/kegiatan-panti.png',
      alt: '[Placeholder: Foto Kegiatan Anak Asuh]',
    }}
    callToAction={{
      text: 'Selengkapnya tentang kami',
      href: getPermalink('/tentang'),
    }}
  >
    <Fragment slot="content">
      <p>[Placeholder paragraf pengenalan singkat mengenai yayasan dan panti asuhan.]</p>
    </Fragment>
  </Content>

  <!-- Program Unggulan -->
  <Features
    id="program"
    tagline="Program Kami"
    title="[Judul Bagian Program Unggulan]"
    subtitle="[Sub-judul singkat mengenai program pembinaan anak asuh]"
    items={[
      {
        title: '[Program 1: Pendidikan]',
        description: '[Placeholder deskripsi program pendidikan formal/non-formal]',
        icon: 'tabler:book',
      },
      {
        title: '[Program 2: Pembinaan Karakter]',
        description: '[Placeholder deskripsi program pembinaan karakter/agama]',
        icon: 'tabler:heart',
      },
      {
        title: '[Program 3: Kesehatan & Gizi]',
        description: '[Placeholder deskripsi program pemenuhan gizi dan kesehatan]',
        icon: 'tabler:medical-cross',
      },
      {
        title: '[Program 4: Keterampilan & Bakat]',
        description: '[Placeholder deskripsi program pengembangan minat dan bakat]',
        icon: 'tabler:palette',
      },
    ]}
  />

  <!-- Berita / Kegiatan Terbaru -->
  <BlogLatestPosts
    title="[Judul Bagian Berita & Kegiatan Terbaru]"
    information="[Placeholder deskripsi singkat bagian kabar terbaru dan dokumentasi kegiatan]"
    linkText="Lihat semua berita"
    linkUrl={getPermalink('/berita')}
  />

  <!-- Ajakan Donasi -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Salurkan Donasi',
        href: getPermalink('/donasi'),
        icon: 'tabler:heart-handshake',
      },
      {
        text: 'Hubungi Kami',
        href: getPermalink('/kontak'),
      },
    ]}
  >
    <Fragment slot="title">[Judul Ajakan Donasi / Dukungan]</Fragment>

    <Fragment slot="subtitle">
      [Placeholder kalimat ajakan singkat untuk berdonasi, menjadi orang tua asuh, atau berkunjung]
    </Fragment>
  </CallToAction>
</Layout>
