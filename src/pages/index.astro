---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Quote from '~/components/widgets/Quote.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Yayasan Anak Yatim At-Taufiq Malang — Bersama kita merajut masa depan Anak Yatim',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Section -->
  <Hero
    tagline="Yayasan Anak Yatim At-Taufiq"
    actions={[
      {
        variant: 'primary',
        text: 'Profil Yayasan',
        href: getPermalink('/tentang'),
      },
    ]}
    image={{
      src: '~/assets/images/yayasan/hero-pengasuhan.jpg',
      alt: 'Pengasuhan anak yatim dan dhuafa di Yayasan Anak Yatim At-Taufiq Malang',
    }}
  >
    <Fragment slot="title">
      Bersama kita merajut <span class="text-accent dark:text-white">masa depan Anak Yatim</span>
    </Fragment>

    <Fragment slot="subtitle">
      Yayasan Attaufiq adalah Yayasan yang fokus mengabdi untuk mengasuh anak Yatim Piatu dan fakir miskin yang berada
      di Malang. Dengan segala kemampuan, kami bertanggungjawab mewujudkan cita cita Anak Yatim agar bisa terwujud kelak
      hingga mereka dewasa.
    </Fragment>
  </Hero>

  <!-- Data Anak Asuh -->
  <Stats
    title="Data Anak Asuh"
    subtitle="Total 34 anak asuh dalam pembinaan Yayasan Anak Yatim At-Taufiq Malang"
    stats={[
      { title: 'TK & Balita', amount: '4' },
      { title: 'SD / MI', amount: '13' },
      { title: 'SMP / MTs', amount: '6' },
      { title: 'Mahasiswa', amount: '11' },
    ]}
  />

  <!-- Pesan / Ayat -->
  <Quote
    quote="Sembahlah Allah dan janganlah kamu mempersekutukan-Nya dengan sesuatupun. Dan berbuat baiklah kepada dua orang ibu-bapak, karib-kerabat, anak-anak yatim, orang-orang miskin…."
    name="QS. an-Nisa: 36"
  />

  <!-- Kegiatan Kami -->
  <Features
    id="kegiatan"
    tagline="Kegiatan Kami"
    title="Dokumentasi & Kegiatan Yayasan"
    subtitle="Beberapa catatan kegiatan yang telah dilaksanakan bersama anak asuh dan pengurus"
    items={[
      {
        title: 'Pembersihan lokasi pembangunan Asrama Putri',
        description: '11 Mei 2017',
        icon: 'tabler:building-community',
      },
      {
        title: 'Pembersihan Taman Yayasan At-Taufiq',
        description: '12 Desember 2016',
        icon: 'tabler:plant',
      },
      {
        title: 'Lebaran 1437 H',
        description: '7 Juli 2016',
        icon: 'tabler:moon-stars',
      },
      {
        title: 'Malam Takbir 1437 H',
        description: '7 Juli 2016',
        icon: 'tabler:sparkles',
      },
    ]}
  />

  <!-- Lokasi Yayasan -->
  <Content
    isReversed
    tagline="Lokasi Yayasan"
    title="Yayasan Anak Yatim At-Taufiq"
    items={[
      {
        title: 'Alamat',
        description: 'Jl. Sanan 70 RT 08 RW.15 Purwantoro, Blimbing, Malang 65122',
      },
      {
        title: 'Telepon',
        description: '(0341) 411105',
      },
    ]}
    image={{
      src: '~/assets/images/yayasan/taman-yayasan.jpg',
      alt: 'Taman asri di lingkungan Yayasan Anak Yatim At-Taufiq Malang',
      aspect: '4/3',
    }}
    callToAction={{
      text: 'Buka di Google Maps',
      href: 'https://www.google.com/maps/search/?api=1&query=-7.9609307,112.6455318',
      target: '_blank',
    }}
  >
    <Fragment slot="content">
      <p>Kunjungi asrama kami di kawasan Purwantoro, Blimbing, Kota Malang atau hubungi pengurus melalui telepon.</p>
    </Fragment>
  </Content>

  <!-- Ajakan Donasi -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Salurkan Donasi',
        href: getPermalink('/donasi'),
        icon: 'tabler:heart-handshake',
      },
      {
        text: 'Hubungi Kami',
        href: getPermalink('/kontak'),
      },
    ]}
  >
    <Fragment slot="title">Bersama Merajut Masa Depan Anak Yatim</Fragment>

    <Fragment slot="subtitle">
      Dukungan dan kepedulian Anda membantu mewujudkan cita-cita anak yatim piatu dan dhuafa hingga mereka dewasa.
    </Fragment>
  </CallToAction>
</Layout>
