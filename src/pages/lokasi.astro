---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Lokasi Asrama',
  description:
    'Peta dan petunjuk arah menuju 2 lokasi asrama Yayasan Anak Yatim At-Taufiq Malang di Jl. Sanan, Purwantoro, Blimbing, Kota Malang.',
};

const asramaList = [
  {
    badge: 'Asrama 1 · Kantor Yayasan',
    title: 'Asrama Putra & Sekretariat At-Taufiq',
    address: 'Jl. Sanan Bawah No.70, RT 08 RW 15, Purwantoro, Kec. Blimbing, Kota Malang, Jawa Timur 65126',
    phone: '(0341) 411105',
    embedUrl: 'https://maps.google.com/maps?q=-7.9609307,112.6455318&z=17&output=embed',
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.9609307,112.6455318',
    directionsUrl: 'https://www.google.com/maps/dir/?api=1&destination=-7.9609307,112.6455318',
    mapTitle: 'Peta Lokasi Asrama 1 Yayasan Anak Yatim At-Taufiq Malang',
  },
  {
    badge: 'Asrama 2 · Ma’had Putri',
    title: 'Ma’had Putri At-Taufiq 2',
    address: 'Jl. Sanan No.125, Purwantoro, Kec. Blimbing, Kota Malang, Jawa Timur 65126',
    phone: '(0341) 411105',
    embedUrl: 'https://maps.google.com/maps?q=-7.961849,112.646862&z=17&output=embed',
    mapsUrl: 'https://maps.app.goo.gl/Jav4NhgyFfro2TXi6',
    directionsUrl: 'https://www.google.com/maps/dir/?api=1&destination=-7.961849,112.646862',
    mapTitle: 'Peta Lokasi Asrama 2 Ma’had Putri At-Taufiq 2 Malang',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Peta & Petunjuk Arah"
    title="Lokasi 2 Asrama Panti Asuhan At-Taufiq"
    subtitle="Kunjungi langsung kedua asrama kami di kawasan Sanan, Purwantoro, Blimbing, Kota Malang."
  />

  <WidgetWrapper id="peta-asrama" containerClass="max-w-7xl mx-auto pt-0 md:pt-0">
    <div class="grid gap-8 md:grid-cols-2">
      {
        asramaList.map((item) => (
          <article class="flex flex-col rounded-2xl border border-primary/15 dark:border-emerald-500/20 bg-white dark:bg-slate-900/80 shadow-lg shadow-primary/5 overflow-hidden">
            <div class="p-6 pb-4 space-y-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 dark:bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-primary dark:text-emerald-300">
                <Icon name="tabler:map-pin" class="w-3.5 h-3.5" />
                {item.badge}
              </span>
              <h2 class="text-2xl font-bold font-heading tracking-tight">{item.title}</h2>
              <p class="text-sm text-muted leading-relaxed">{item.address}</p>
              <p class="text-sm text-muted flex items-center gap-1.5">
                <Icon name="tabler:phone" class="w-4 h-4 text-primary dark:text-emerald-400 shrink-0" />
                <span>Telepon: {item.phone}</span>
              </p>
            </div>

            <div class="px-6 mt-auto">
              <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700/70 bg-gray-100 dark:bg-slate-800 aspect-[4/3]">
                <iframe
                  title={item.mapTitle}
                  src={item.embedUrl}
                  class="w-full h-full border-0"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </div>
            </div>

            <div class="p-6 pt-5 flex flex-wrap gap-3">
              <Button
                variant="primary"
                text="Petunjuk Arah"
                href={item.directionsUrl}
                target="_blank"
                icon="tabler:navigation"
                class="flex-1 text-sm py-2.5 px-4"
              />
              <Button
                variant="secondary"
                text="Buka Google Maps"
                href={item.mapsUrl}
                target="_blank"
                icon="tabler:external-link"
                class="flex-1 text-sm py-2.5 px-4"
              />
            </div>
          </article>
        ))
      }
    </div>
  </WidgetWrapper>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Hubungi Pengurus',
        href: getPermalink('/kontak'),
        icon: 'tabler:brand-whatsapp',
      },
      {
        text: 'Salurkan Donasi',
        href: getPermalink('/donasi'),
      },
    ]}
  >
    <Fragment slot="title">Berencana Berkunjung atau Mengantar Bantuan?</Fragment>
    <Fragment slot="subtitle">
      Silakan hubungi pengurus terlebih dahulu melalui telepon (0341) 411105 atau halaman kontak agar kami dapat
      menyambut kedatangan Anda.
    </Fragment>
  </CallToAction>
</Layout>
