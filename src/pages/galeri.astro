---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const metadata = {
  title: 'Galeri Kegiatan',
  description: 'Dokumentasi kegiatan Yayasan Anak Yatim At-Taufiq Malang melalui feed Instagram @yayasan_attaufiqmlg.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="Dokumentasi"
    title="Galeri Kegiatan"
    subtitle="Ikuti dokumentasi kegiatan anak asuh dan aktivitas Yayasan Anak Yatim At-Taufiq Malang."
  />

  <!-- Elfsight Social Feed -->
  <WidgetWrapper containerClass="max-w-6xl mx-auto">
    <Headline tagline="Instagram Resmi" title="@yayasan_attaufiqmlg" />
    <div class="mt-4">
      <!-- Elfsight Social Feed | Untitled Social Feed -->
      <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
      <div class="elfsight-app-4092435d-5066-42da-b781-64a9f0174127" data-elfsight-app-lazy></div>
    </div>
  </WidgetWrapper>
</Layout>
