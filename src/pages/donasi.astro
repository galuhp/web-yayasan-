---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Donasi',
  description:
    'Salurkan infaq, shodaqoh, zakat, sembako, atau beasiswa orang tua asuh melalui Yayasan Anak Yatim At-Taufiq Malang.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="Donasi & Kepedulian"
    title="Salurkan Kebaikan, Rajut Masa Depan Anak Yatim"
    subtitle="Setiap dukungan Anda membantu biaya pendidikan, kebutuhan harian, dan pembinaan 34 anak asuh di Yayasan Anak Yatim At-Taufiq Malang hingga mereka mandiri."
  />

  <!-- Pilihan Jenis Donasi -->
  <Features2
    tagline="Bentuk Dukungan"
    title="Pilihan Penyaluran Donasi"
    columns={2}
    items={[
      {
        title: 'Infaq, Shodaqoh & Zakat',
        description:
          'Donasi dana untuk kebutuhan makan sehari-hari, operasional asrama putra dan putri, serta pembinaan anak asuh.',
        icon: 'tabler:cash',
      },
      {
        title: 'Donasi Sembako & Kebutuhan Pokok',
        description:
          'Menerima bantuan beras, minyak goreng, lauk pauk, perlengkapan mandi, maupun alat tulis yang dapat diantar langsung ke asrama.',
        icon: 'tabler:package',
      },
      {
        title: 'Program Orang Tua Asuh / Beasiswa',
        description:
          'Dukungan biaya pendidikan berkala bagi anak asuh dari jenjang TK/Balita, SD/MI, SMP/MTs, hingga Mahasiswa.',
        icon: 'tabler:school',
      },
      {
        title: 'Kunjungan, Doa Bersama & Santunan',
        description:
          'Yayasan terbuka bagi donatur, komunitas, maupun instansi yang ingin bersilaturahmi, mengadakan buka bersama, atau syukuran bersama anak asuh.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Rekening Resmi -->
  <Content
    id="rekening"
    tagline="Rekening Resmi"
    title="Rekening Donasi"
    items={[
      {
        title: 'BNI Syariah (cabang Malang)',
        description: 'No. Rekening: 0127054102 — a.n. Yayasan Anak Yatim At-Taufiq Malang',
      },
      {
        title: 'BTN Syariah (cabang Malang)',
        description: 'No. Rekening: 7062073187 — a.n. Yayasan Anak Yatim At-Taufiq Malang',
      },
      {
        title: 'Konfirmasi Transfer',
        description: 'Telepon: (0341) 411105 · WhatsApp: [Nomor WhatsApp Bendahara / Admin Konfirmasi]',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        Mohon pastikan nama penerima yang tertera adalah <strong>Yayasan Anak Yatim At-Taufiq Malang</strong> sebelum melakukan
        transfer. Setelah transfer, silakan konfirmasi melalui telepon atau WhatsApp pengurus.
      </p>
    </Fragment>
  </Content>
</Layout>
