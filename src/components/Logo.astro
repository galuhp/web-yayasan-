---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logoImg from '~/assets/images/logo.png';
---

<span class="inline-flex items-center gap-2.5 self-center">
  <Image
    src={logoImg}
    alt={SITE?.name || 'Logo Panti Asuhan At-Taufiq Malang'}
    width={36}
    height={36}
    class="h-8 w-8 sm:h-9 sm:w-9 rounded-full object-contain shrink-0"
    loading="eager"
  />
  <span
    class="text-base sm:text-lg font-bold tracking-tight text-[#14532D] whitespace-nowrap dark:text-emerald-50 max-w-[200px] sm:max-w-none truncate"
  >
    {SITE?.name}
  </span>
</span>
